# ===== 平台形态 =====
# h5 = H5移动Web（比赛演示期）| welink = WeLink内嵌
PLATFORM=h5

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PLATFORM=h5

# ===== 后端 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 =====
# DB_DRIVER: sqlite | pg
DB_DRIVER=sqlite
# SQLite 文件路径（DB_DRIVER=sqlite 时使用）
DB_SQLITE_PATH=./data/dev.db
# PostgreSQL 连接串（DB_DRIVER=pg 时使用）
DB_URL=postgresql://user:password@localhost:5432/nihao_deutsch

# ===== 认证 =====
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_EXPIRES_IN=8h
# 登录失败锁定阈值
LOGIN_FAIL_LOCK_THRESHOLD=5
# 登录锁定时长（分钟）
LOGIN_LOCK_MINUTES=15

# ===== 安全 =====
HTTPS_ENABLED=false
# HTTPS 证书路径（HTTPS_ENABLED=true 时使用）
HTTPS_CERT_PATH=./certs/server.crt
HTTPS_KEY_PATH=./certs/server.key
# CORS 允许来源
CORS_ORIGIN=http://localhost:5173

# ===== 文件上传 =====
# 导入文件最大体积（MB）
IMPORT_MAX_MB=10

# ===== 日志 =====
LOG_LEVEL=info